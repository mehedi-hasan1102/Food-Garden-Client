{
  "name": "foodly",
  "version": "1.0.0",
  "private": true,
  "description": "Foodly — full-stack food inventory app (Express API + React/Vite frontend) in a Bun monorepo.",
  "author": "Mehedi Hasan <hello@mehedi-hasan.me>",
  "keywords": [
    "food",
    "food-tracking",
    "food-inventory",
    "inventory",
    "express",
    "react",
    "vite",
    "mongodb",
    "firebase",
    "authentication",
    "jwt",
    "monorepo",
    "turborepo",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMehediHQ/Foodly.git"
  },
  "homepage": "https://github.com/TheMehediHQ/Foodly#readme",
  "bugs": "https://github.com/TheMehediHQ/Foodly/issues",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@foodly/web",
    "dev:api": "turbo run dev --filter=@foodly/api",
    "build": "turbo run build && node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.cpSync('apps/web/dist','dist',{recursive:true})\"",
    "build:web": "turbo run build --filter=@foodly/web",
    "build:vercel": "cd apps/web && bun run build && cp -r dist ../dist",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@foodly/web",
    "lint:api": "turbo run lint --filter=@foodly/api",
    "format": "prettier --write .",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0"
  }
}
