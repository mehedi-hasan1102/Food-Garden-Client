{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "bun run build",
        "outputDirectory": "dist"
      }
    },
    {
      "src": "apps/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/api/index.js"
    }
  ]
}
